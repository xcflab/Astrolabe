+def _compute_chain_pair_iptm(
+    logits: np.ndarray,
+    breaks: np.ndarray,
+    asym_id: np.ndarray,
+) -> np.ndarray:
+  """Computes one symmetric iPTM value for every pair of chains."""
+  logits = np.asarray(logits)
+  breaks = np.asarray(breaks)
+  asym_id = np.asarray(asym_id).reshape(-1)
+  chain_ids = list(dict.fromkeys(asym_id.tolist()))
+  scores = np.zeros((len(chain_ids), len(chain_ids)), dtype=np.float32)
+  for left_idx, left_chain in enumerate(chain_ids):
+    for right_idx in range(left_idx + 1, len(chain_ids)):
+      right_chain = chain_ids[right_idx]
+      pair_mask = np.isin(asym_id, (left_chain, right_chain))
+      pair_logits = logits[pair_mask][:, pair_mask, :]
+      pair_asym_id = asym_id[pair_mask]
+      pair_score = confidence.predicted_tm_score(
+          logits=pair_logits,
+          breaks=breaks,
+          asym_id=pair_asym_id,
+          interface=True,
+      )
+      scores[left_idx, right_idx] = pair_score
+      scores[right_idx, left_idx] = pair_score
+  return scores
+
+
+def _compute_chain_ptm(
+    logits: np.ndarray,
+    breaks: np.ndarray,
+    asym_id: np.ndarray,
+) -> np.ndarray:
+  """Computes one within-chain pTM value for every chain."""
+  logits = np.asarray(logits)
+  breaks = np.asarray(breaks)
+  asym_id = np.asarray(asym_id).reshape(-1)
+  chain_ids = list(dict.fromkeys(asym_id.tolist()))
+  scores = np.zeros(len(chain_ids), dtype=np.float32)
+  for chain_idx, chain_id in enumerate(chain_ids):
+    chain_mask = asym_id == chain_id
+    chain_logits = logits[chain_mask][:, chain_mask, :]
+    scores[chain_idx] = confidence.predicted_tm_score(
+        logits=chain_logits,
+        breaks=breaks,
+    )
+  return scores
+
+
