+
+    rel_sep_feat = batch["features"].get("RelativeSequenceSeparation")
+    if rel_sep_feat is None:
+        return
+
+    token_asym_id = batch["inputs"]["token_asym_id"][0].long()
+    token_exists = batch["inputs"]["token_exists_mask"][0].bool()
+    token_subchain_id = batch["inputs"]["subchain_id"][0]
+    rel_sep_data = rel_sep_feat[..., 0]
+    sep_bins = torch.tensor(
+        SMALL_SEP_BINS, device=rel_sep_data.device, dtype=torch.float32
+    )
