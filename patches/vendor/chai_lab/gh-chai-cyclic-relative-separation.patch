+            token_asym_id=token_asym_id,
+        )
+        if asym_id not in cyclic_asym_ids:
+            cyclic_asym_ids.append(int(asym_id))
+
+    for asym_id in cyclic_asym_ids:
+        chain_mask = (token_asym_id == asym_id) & token_exists
+        indices = torch.where(chain_mask)[0]
+        length = int(indices.numel())
+        if length <= 2:
+            continue
+
+        local = torch.arange(length, device=rel_sep_data.device, dtype=torch.int64)
+        wrapped = local[:, None] - local[None, :]
+        half = length // 2
+        wrapped = torch.where(wrapped > half, wrapped - length, wrapped)
+        wrapped = torch.where(wrapped < -half, wrapped + length, wrapped)
+        encoded = torch.searchsorted(sep_bins, wrapped.float() + 1e-4).to(
+            rel_sep_data.dtype
+        )
+        rel_sep_data[0, indices[:, None], indices[None, :]] = encoded
+
+    if not cyclic_relative_patches:
+        return
+
+    for patch in cyclic_relative_patches:
+        chain_id = str(patch["chain_id"])
+        asym_id = get_asym_id_from_subchain_id(
+            subchain_id=chain_id,
+            source_pdb_chain_id=token_subchain_id,
+            token_asym_id=token_asym_id,
